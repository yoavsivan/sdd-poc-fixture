@@ -0,0 +1,4 @@
+import { Router } from "express";
+export function keysRouter() {
+  const router = Router();
+  router.get("/api-keys", (_req, res) => { res.json([]); });
+  router.get("/items/{id}", (_req, res) => { res.json({}); });
+  router.get("/items/<id>", (_req, res) => { res.json({}); });
+  return router;
+}
