+    expect(again.status).toBe(401);
+    expect(again.text).toBe('{"error":"unauthorized"}');
+    const listed = await request(app).get("/settings").set("Cookie", cookie);
+    expect(listed.text).not.toContain('data-testid="api-key-row"');
+  });
