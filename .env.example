# Copy values into the shell or into docker compose. The app reads process.env
# directly; this file is documentation only and is never loaded at runtime.

PORT=3000
DATABASE_PATH=./data/shelfmark.db
SESSION_SECRET=dev-only-secret-change-me
COOKIE_SECURE=false
SEED_USER=demo
SEED_PASSWORD=demo-pass-1234
SEED_ITEMS=false
LOG_LEVEL=info
NODE_ENV=development

# Playwright (smoke-local / compose playwright service)
BASE_URL=http://localhost:3000
