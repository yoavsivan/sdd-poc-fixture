<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="<%= locals.user ? "/items" : "/signin" %>">Shelfmark</a>
    <nav class="nav" aria-label="Main">
      <% if (locals.user) { %>
        <a class="nav-link" href="/items">Items</a>
        <a class="nav-link" href="/settings" data-testid="settings-nav">Settings</a>
        <span class="nav-user" data-testid="nav-user"><%= locals.user.username %></span>
        <form class="nav-signout" method="post" action="/signout">
          <input type="hidden" name="_csrf" value="<%= locals.csrf %>" />
          <button type="submit" class="btn btn-quiet" data-testid="nav-signout">Sign out</button>
        </form>
      <% } else { %>
        <a class="nav-link" href="/signin">Sign in</a>
      <% } %>
    </nav>
  </div>
</header>
