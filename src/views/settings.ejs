<section class="settings-page">
  <header class="page-head">
    <div>
      <h1>Settings</h1>
      <p class="lede">Account details, password, API keys, and how to call the JSON API.</p>
    </div>
  </header>

  <section class="panel" data-testid="settings-account">
    <h2>Account</h2>
    <dl class="kv">
      <div>
        <dt>Username</dt>
        <dd><%= locals.user ? locals.user.username : "" %></dd>
      </div>
      <div>
        <dt>Signed in</dt>
        <dd>Yes. Sessions live in memory and do not survive a process restart.</dd>
      </div>
    </dl>
  </section>

  <section class="panel" data-testid="settings-password">
    <h2>Password</h2>
    <% if (passwordError) { %>
      <p class="form-error" role="alert"><%= passwordError %></p>
    <% } %>
    <form method="post" action="/settings/password" class="stack">
      <input type="hidden" name="_csrf" value="<%= locals.csrf %>" />
      <label class="field">
        <span>Current password</span>
        <input type="password" name="current" autocomplete="current-password" required />
        <%- include("partials/field-error", { field: "current", errors: errors }) %>
      </label>
      <label class="field">
        <span>New password</span>
        <input type="password" name="next" autocomplete="new-password" required minlength="8" />
        <%- include("partials/field-error", { field: "next", errors: errors }) %>
      </label>
      <label class="field">
        <span>Confirm new password</span>
        <input type="password" name="confirm" autocomplete="new-password" required minlength="8" />
        <%- include("partials/field-error", { field: "confirm", errors: errors }) %>
      </label>
      <button type="submit" class="btn btn-primary">Update password</button>
    </form>
  </section>

  <section class="panel" data-testid="api-keys-section">
    <h2>API keys</h2>
    <p>
      Create a named key to call <code>/api/*</code> with
      <code>Authorization: Bearer</code>. The secret is shown once at create.
      Revoke is immediate.
    </p>
    <% if (typeof apiKeyError === "string" && apiKeyError) { %>
      <p class="form-error" role="alert"><%= apiKeyError %></p>
    <% } %>
    <% if (typeof apiKeyPlaintext === "string" && apiKeyPlaintext) { %>
      <p class="flash" role="status">Copy this secret now. Reloading this page hides it.</p>
      <pre class="code-block"><code data-testid="api-key-plaintext"><%= apiKeyPlaintext %></code></pre>
    <% } %>
    <form method="post" action="/settings/api-keys" class="stack">
      <input type="hidden"
        name="_csrf" value="<%= locals.csrf %>" />
      <label class="field">
        <span>Name</span>
        <input
          type="text"
          data-testid="api-key-name"
          name="api_key_name"
          maxlength="80"
          required
        />
        <%- include("partials/field-error", { field: "api_key_name", errors: errors }) %>
      </label>
      <button type="submit" class="btn btn-primary" data-testid="api-key-create">Create key</button>
    </form>
    <% const keys = typeof apiKeys === "object" && Array.isArray(apiKeys) ? apiKeys : []; %>
    <% if (keys.length) { %>
      <ul class="api-key-list">
        <% keys.forEach(function (key) { %>
          <li class="api-key-row" data-testid="api-key-row">
            <div>
              <p class="api-key-name"><%= key.name %></p>
              <p class="muted"><code><%= key.masked %></code></p>
              <p class="muted">
                Created
                <time data-testid="api-key-created"><%= key.created %></time>
                · Last used
                <time data-testid="api-key-last-used"><%= key.lastUsed %></time>
              </p>
            </div>
            <form method="post" action="/settings/api-keys/<%= key.id %>/revoke" data-confirm="Revoke this API key immediately?">
              <input type="hidden"
                name="_csrf" value="<%= locals.csrf %>" />
              <button type="submit" class="btn btn-danger" data-testid="api-key-revoke">Revoke</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="panel" data-testid="settings-api-usage">
    <h2>Using the API</h2>
    <p>
      The JSON API lives at <code>/api/items</code>. Authenticate with a session
      cookie or with <code>Authorization: Bearer</code> and an API key:
    </p>
    <pre class="code-block"><code>C=$(scripts/login.sh demo demo-pass-1234)
curl -s -b "$C" http://localhost:3000/api/items
curl -s -H "Authorization: Bearer YOUR_KEY" http://localhost:3000/api/items</code></pre>
    <p class="muted">
      Writes must send <code>Content-Type: application/json</code>. A missing
      session or a bad key answers <code>{"error":"unauthorized"}</code>.
    </p>
  </section>
</section>
