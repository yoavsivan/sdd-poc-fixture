+function isApiPath(req: { path: string; originalUrl?: string }): boolean {
+  const path = req.path || "";
+  const original = req.originalUrl || "";
+  return (
+    path === "/api" ||
+    path.startsWith("/api/") ||
+    original === "/api" ||
