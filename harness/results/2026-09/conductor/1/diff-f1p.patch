+      .redirects(0);
+    expect(revoke.status).toBe(302);
+    const denied = await request(app).get("/api/items").set("Authorization", `Bearer ${secret}`);
+    expect(denied.status).toBe(401);
+    expect(denied.text).toBe('{"error":"unauthorized"}');
