<section class="settings-page">
  <header class="page-head">
    <div>
      <h1>Settings</h1>
      <p class="lede">Account details, password, API keys, and how to call the JSON API.</p>
    </div>
  </header>

  <section class="panel" data-testid="settings-account">
    <h2>Account</h2>
    <dl class="kv">
      <div>
        <dt>Username</dt>
        <dd><%= locals.user ? locals.user.username : "" %></dd>
      </div>
      <div>
        <dt>Signed in</dt>
        <dd>Yes. Sessions live in memory and do not survive a process restart.</dd>
      </div>
    </dl>
  </section>

  <section class="panel" data-testid="settings-password">
    <h2>Password</h2>
    <% if (passwordError) { %>
      <p class="form-error" role="alert"><%= passwordError %></p>
    <% } %>
    <form method="post" action="/settings/password" class="stack">
      <input type="hidden" name="_csrf" value="<%= locals.csrf %>" />
      <label class="field">
        <span>Current password</span>
        <input type="password" name="current" autocomplete="current-password" required />
        <%- include("partials/field-error", { field: "current", errors: errors }) %>
      </label>
      <label class="field">
        <span>New password</span>
        <input type="password" name="next" autocomplete="new-password" required minlength="8" />
        <%- include("partials/field-error", { field: "next", errors: errors }) %>
      </label>
      <label class="field">
        <span>Confirm new password</span>
        <input type="password" name="confirm" autocomplete="new-password" required minlength="8" />
        <%- include("partials/field-error", { field: "confirm", errors: errors }) %>
      </label>
      <button type="submit" class="btn btn-primary">Update password</button>
    </form>
  </section>

  <section class="panel" data-testid="api-keys-section">
    <h2>API keys</h2>
    <p>
      Create a named key to call <code>/api/*</code> with
      <code>Authorization: Bearer</code> instead of a session cookie.
      The secret is shown once at create. Revoke is immediate.
    </p>
    <% if (apiKeyPlaintext) { %>
      <p class="flash" role="status">Copy this secret now. It will not be shown again.</p>
      <p><code data-testid="api-key-plaintext"><%= apiKeyPlaintext %></code></p>
    <% } %>
    <form method="post" action="/settings/api-keys" class="stack key-create">
      <input type="hidden" name="_csrf" value="<%= locals.csrf %>" />
      <label class="field">
        <span>Key name</span>
        <input
          type="text"
          name="name"
          data-testid="api-key-name"
          maxlength="80"
          required
          value="<%= typeof apiKeyNameValue === 'string' ? apiKeyNameValue : '' %>"
        />
        <%- include("partials/field-error", { field: "name", errors: errors }) %>
      </label>
      <button type="submit" class="btn btn-primary" data-testid="api-key-create">Create key</button>
    </form>
    <% if (apiKeys && apiKeys.length) { %>
      <ul class="key-list">
        <% apiKeys.forEach(function (key) { %>
          <li class="key-row" data-testid="api-key-row">
            <div>
              <p class="key-name"><%= key.name %></p>
              <p class="muted">
                <code>smk_<%= key.prefix %>_****<%= key.last4 %></code>
              </p>
              <p class="muted">
                Created
                <time data-testid="api-key-created" datetime="<%= key.createdDate %>"><%= key.createdDate %></time>
                <% if (key.lastUsedDate) { %>
                  · Last used
                  <time data-testid="api-key-last-used" datetime="<%= key.lastUsedDate %>"><%= key.lastUsedDate %></time>
                <% } %>
                <% if (key.lastRotatedDate) { %>
                  · Last rotated
                  <time data-testid="api-key-last-rotated" datetime="<%= key.lastRotatedDate %>"><%= key.lastRotatedDate %></time>
                <% } %>
              </p>
            </div>
            <% if (!key.revoked) { %>
              <div class="key-actions">
                <form method="post" action="/settings/api-keys/<%= key.id %>/rotate">
                  <input type="hidden" name="_csrf" value="<%= locals.csrf %>" />
                  <button type="submit" class="btn btn-quiet" data-testid="api-key-rotate">Rotate</button>
                </form>
                <form method="post" action="/settings/api-keys/<%= key.id %>/revoke">
                  <input type="hidden" name="_csrf" value="<%= locals.csrf %>" />
                  <button type="submit" class="btn btn-danger" data-testid="api-key-revoke">Revoke</button>
                </form>
              </div>
            <% } else { %>
              <p class="muted">Revoked</p>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="panel" data-testid="settings-api-usage">
    <h2>Using the API</h2>
    <p>
      The JSON API lives at <code>/api/items</code>. Prefer a named API key from
      the section above. A session cookie still works for the browser:
    </p>
    <pre class="code-block"><code>C=$(scripts/login.sh demo demo-pass-1234)
curl -s -b "$C" http://localhost:3000/api/items
curl -s -H "Authorization: Bearer YOUR_KEY" http://localhost:3000/api/items</code></pre>
    <p class="muted">
      Writes must send <code>Content-Type: application/json</code>. A missing
      session or key answers <code>{"error":"unauthorized"}</code>.
    </p>
  </section>
</section>
